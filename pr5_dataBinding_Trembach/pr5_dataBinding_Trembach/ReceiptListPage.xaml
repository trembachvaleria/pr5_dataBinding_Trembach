<Page x:Class="pr5_dataBinding_Trembach.ReceiptListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr5_dataBinding_Trembach"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="Список чеков" Background="LightPink">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Text="Список чеков" FontSize="20" HorizontalAlignment="Center" Margin="10"/>

        <ListView x:Name="lvList" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding List}" SelectedItem="{Binding Selected}" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Чек №: "/>
                            <TextBlock Text="{Binding Id}" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Дата: "/>
                            <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Касса: "/>
                            <TextBlock Text="{Binding CashNumber}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Кассир: "/>
                            <TextBlock Text="{Binding Cashier}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Итого: "/>
                            <TextBlock Text="{Binding Total, Mode=OneWay}" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center" Margin="10">
            <Button Content="Добавить" Width="100" Height="30" Margin="10" Click="btnAdd_Click" Background="Pink"/>
            <Button Content="Удалить" Width="100" Height="30" Margin="10" Click="btnDelete_Click" Background="Pink"/>
            <Button Content="Редактировать" Width="100" Height="30" Margin="10" Click="btnEdit_Click" Background="Pink"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Margin="10">
            <TextBlock Text="Всего чеков: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding List.Count}" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
